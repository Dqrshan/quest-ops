# Organizer console passcode. Required in production; optional in dev (console is open when unset).
CONSOLE_PASSCODE=

# AI quest generation. Set one; the first one set wins (Groq, then Anthropic, then OpenAI).
# With none set, the built-in packs are used.
# Groq has a free tier: create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public origin used inside printed QR codes. Defaults to the request origin.
PUBLIC_ORIGIN=
