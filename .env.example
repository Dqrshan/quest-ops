# Organizer console passcode. Required in production; optional in dev (console is open when unset).
CONSOLE_PASSCODE=

# AI quest generation. Set one; with none set, a built-in generator is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public origin used inside printed QR codes. Defaults to the request origin.
PUBLIC_ORIGIN=
